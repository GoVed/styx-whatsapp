# Styx WhatsApp Connect Micro-Daemon Configuration
# ===================================================

# Bridge Mode: "live" (Real WhatsApp Web via Baileys) or "mock" (Offline Dev Simulator)
WHATSAPP_MODE=mock

# Directory storing encrypted multi-device session credentials
# NOTE: Kept strictly isolated inside this repository with 0700 permissions
WHATSAPP_AUTH_DIR=./.auth_session

# Styx Agent OS Endpoint (for forwarding inbound messages to POST /api/tools/trigger)
STYX_API_URL=http://localhost:3000

# Styx Access Key (if configured in Styx STYX_ACCESS_KEY environment variable)
STYX_ACCESS_KEY=styx-local-dev-key

# MCP Daemon HTTP Server Port (when running in background daemon mode)
HTTP_PORT=8765
HTTP_HOST=127.0.0.1

# Logging level: trace, debug, info, warn, error
LOG_LEVEL=info

# Auto-reconnect attempts for WhatsApp bridge
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_INTERVAL_MS=3000
